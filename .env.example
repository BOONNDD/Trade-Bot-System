# ════════════════════════════════════════════════════════════════════════
#  V11 MAGNETAR — Environment Variables Configuration
#  انسخ هذا الملف وأعد تسميته إلى .env وأضف قيمك الخاصة
#  Copy this file, rename it to .env, and fill in your values
# ════════════════════════════════════════════════════════════════════════

# ── Telegram Bot Configuration ───────────────────────────────────────────
# رمز بوت التليغرام — احصل عليه من @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# معرف المحادثة — احصل عليه من @userinfobot
CHAT_ID=your_telegram_chat_id_here

# ── Trading Platform ─────────────────────────────────────────────────────
# رابط منصة التداول — تأكد من تسجيل الدخول أولاً عبر SESSION_PATH
TARGET_URL=https://pocketoption.com/en/cabinet/demo-quick-high-low/

# ── Puppeteer Settings ───────────────────────────────────────────────────
# وضع headless: true = بدون واجهة مرئية (للخوادم) | false = مع واجهة (للتطوير)
HEADLESS=true

# مجلد حفظ جلسة المتصفح (ملفات الكوكيز والتخزين)
SESSION_PATH=./session

# ── Reconnect Strategy ───────────────────────────────────────────────────
# تأخير إعادة الاتصال الأساسي بالملي ثانية
RECONNECT_DELAY=5000

# أقصى عدد محاولات إعادة الاتصال قبل إعادة تشغيل المحرك كاملاً
MAX_RECONNECT_ATTEMPTS=10

# مدة الانتظار قبل اعتبار البيانات متوقفة (stale) بالملي ثانية
STALE_DATA_TIMEOUT_MS=30000

# ── Logging ──────────────────────────────────────────────────────────────
# مجلد حفظ ملفات السجلات
LOG_DIR=./logs

# أقصى عدد ملفات سجل لكل تصنيف قبل الحذف التلقائي
LOG_MAX_FILES=10

# أقصى حجم لملف السجل بالميغابايت قبل التدوير التلقائي
LOG_MAX_SIZE_MB=10

# ── Heartbeat ────────────────────────────────────────────────────────────
# الفترة الزمنية بين نبضات النظام على تليغرام (بالملي ثانية) — 300000 = 5 دقائق
HEARTBEAT_INTERVAL_MS=300000

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
